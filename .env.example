# ─────────────────────────────────────────────────────────────────────────────
# Zuke environment — copy to `.env.local` for local dev, or set these in your
# host (Vercel: Production + Preview + Development). NEVER commit real secrets;
# this file is the secret-free template.
#
# Legend:  [required to host]  a space create/embed/webhook won't work without it
#          [required to persist] rooms/recordings/participants won't be stored
#          [optional]          a feature degrades gracefully if unset
# ─────────────────────────────────────────────────────────────────────────────


# ── Juke developer API ───────────────────────────────────────────────────────

# [required to host] Server-only key from https://juke.audio/developers.
# Gates every host action: create space, end space, register webhook, mint the
# partner-SSO token. Unset → those routes return 503; anonymous listening still
# works. NEVER expose to the client.
JUKE_API_KEY=

# [required to persist webhooks] HMAC secret that verifies inbound Juke webhook
# deliveries. You do NOT invent this — Juke generates it. Sign in as admin, call
# POST /api/juke/admin/register-webhook, copy `juke.secret` from the response
# here, then redeploy. Until it's set, every delivery 401s → no live status, no
# participant tracking, and no recording.ready → nothing to build a recap from.
JUKE_WEBHOOK_SECRET=

# [optional] Shared password for the /live/create host path, so a teammate can
# create a space without an admin session. Unset → only an admin session can
# create. Use a long random value.
JUKE_CREATE_PASSWORD=


# ── Auth / sessions (iron-session + Sign In With Farcaster) ──────────────────

# [required to host] Cookie encryption secret, MUST be at least 32 characters.
# Any session read throws without it, so admin sign-in and webhook registration
# break. Generate: `openssl rand -base64 32`.
SESSION_SECRET=

# [required to host as admin] Comma-separated Farcaster FIDs granted admin on
# SIWF sign-in (e.g. registering the webhook, admin-create). Put YOUR fid here.
ZUKE_ADMIN_FIDS=

# [deprecated] Legacy plaintext admin-cookie password. Superseded by SIWF +
# ZUKE_ADMIN_FIDS above; leave unset for new deployments.
ZUKE_ADMIN_PASSWORD=


# ── Supabase (persistence) ───────────────────────────────────────────────────

# [required to persist] Project URL. Public (NEXT_PUBLIC_). Without it a space
# can still be created on Juke but nothing is stored, so /live/{id} SSR, the
# recordings shelf, and recap export all come back empty.
NEXT_PUBLIC_SUPABASE_URL=

# [optional] Anon key for browser-side public reads / realtime on /spaces.
# Public (NEXT_PUBLIC_). Missing → the browser client falls back to a harmless
# stub (no realtime), server reads via the service-role key still work.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# [required to persist] Service-role key — full DB access, SERVER ONLY. Powers
# every write (space rows, participants, recordings) and all server reads.
# NEVER expose to the client or commit.
SUPABASE_SERVICE_ROLE_KEY=


# ── Farcaster identity (Neynar) ──────────────────────────────────────────────

# [optional] Server-only key from https://dev.neynar.com. Used for Farcaster
# profile lookups: SIWF sign-in enrichment and the recap PFP/username export
# (GET /api/recordings/recap). Unset → recap returns participants without PFPs
# rather than failing.
NEYNAR_API_KEY=


# ── URLs ─────────────────────────────────────────────────────────────────────

# [recommended] Canonical site origin, no trailing slash (e.g.
# https://zuke.thezao.com). Used for the default webhook URL and share links.
# Unset → falls back to the Vercel alias, else zuke-sandy.vercel.app. On Vercel,
# VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL are provided automatically.
NEXT_PUBLIC_SITE_URL=

# [optional] Optimism RPC for the SIWF AuthKit provider. Has a working public
# default; override only if you want your own endpoint.
NEXT_PUBLIC_OPTIMISM_RPC_URL=


# ── Cron / agents ────────────────────────────────────────────────────────────

# [optional] Bearer secret for the stale-room sweep (GET /api/cron/juke-stale-
# rooms, run every 30 min by vercel.json). The cron route 401s without a match;
# set it if you rely on the sweep to end rooms Juke never sent room.finished for.
CRON_SECRET=

# [optional] Set to "true" to auto-join an agent into freshly started rooms.
# Off by default (the join currently just drops the token). Leave unset.
ZAO_AUTO_AGENT_JOIN=
